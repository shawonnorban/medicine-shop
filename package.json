{
  "name": "medicine-shop",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev:api": "pnpm --filter @medshop/api dev",
    "dev:web": "pnpm --filter @medshop/storefront dev",
