{
  "name": "@medshop/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/server.ts",
    "start": "tsx --env-file=../../.env src/server.ts",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx --env-file=../../.env src/db/migrate.ts",
    "db:seed": "tsx --env-file=../../.env src/db/seed.ts",
    "db:seed:bulk": "tsx --env-file=../../.env src/db/seed-bulk.ts",
    "test": "bash scripts/test.sh",
    "staff:create": "tsx --env-file=../../.env src/scripts/create-staff.ts",
    "db:seed:generics": "tsx --env-file=../../.env src/db/seed-generics.ts",
    "db:wait": "tsx --env-file=../../.env src/db/wait.ts",
    "db:status": "tsx --env-file=../../.env src/db/status.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/cors": "^10.0.1",
    "@fastify/multipart": "^9.4.0",
    "@fastify/static": "^8.3.0",
    "fastify": "^5.1.0",
    "postgres": "^3.4.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
